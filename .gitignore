# Test dependencies — installed fresh by CI (npm install --no-save) and by
# local runs; never committed. Cover any directory so a stray npm install
# at the repo root can't dirty the tree either.
node_modules/
package.json
package-lock.json

# EXCEPTION: the Cloud Functions manifest MUST be committed so `firebase deploy`
# can install its dependencies. Only the root-level test package.json is junk.
!functions/package.json

# Python bytecode from tools/covers.py — regenerated on every run.
__pycache__/
*.pyc
preview/.cliptmp/
