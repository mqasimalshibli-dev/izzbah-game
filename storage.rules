rules_version = '2';

// Izzbah trivia — Firebase Storage rules.
// Question/category images live under categories/. Everyone may READ them (so
// all players see the pictures); only registered admins may upload, and only
// reasonably-sized image files.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 6 * 1024 * 1024            // < 6 MB per image
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
