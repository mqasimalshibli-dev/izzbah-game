{
  "name": "izzbah-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "عزبة (Izzbah) — Capacitor wrapper for the iOS & Android app-store builds",
  "scripts": {
    "copy:web": "node copy-web.js",
    "sync": "npm run copy:web && cap sync",
