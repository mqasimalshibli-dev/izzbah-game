rules_version = '2';

// ============================================================================
//  عزبة (Izzbah) — Firestore security rules
// ----------------------------------------------------------------------------
//  Reading guide (what each collection is for):
//    users/{uid}        A player's own saved settings + progress. Private.
//    admins/{uid}       The list of admins. Being in it = you're an admin.
//    categories/{id}    Official game content. Only admins can write it.
//    community/{id}     Member-submitted categories. Anyone signed in can
//                       SUBMIT one, but it stays hidden until an ADMIN approves
//                       it. Members vote on approved ones.
//
//  Safety model (why this is locked down):
//    • Default is DENY. A path is only writable if a rule below explicitly
//      allows it — the final match/{**} closes everything else.
//    • Every write is checked for: who you are, that you own the data, the
//      exact set of fields, their types, and their sizes. Nothing unexpected
//      can be stored.
//    • Members can never approve their own community category, never vote as
//      someone else or twice, and never edit content that isn't theirs.
//    • Editing an already-approved community category sends it BACK to the
//      review queue, so approved content can't be secretly swapped later.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    // An admin is anyone with a doc at admins/{their-uid}. Bootstrap the FIRST
    // admin by hand in the Firebase console (Firestore > add admins/<uid>).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Shape + size checks shared by community create and author-edit. Keeps a
    // submission small, well-formed, and free of any unexpected fields.
    function validCommunity(d) {
      return d.keys().hasOnly(['name', 'image', 'color', 'questions',
                               'authorUid', 'authorName', 'votes', 'approved',
                               'createdAt', 'updatedAt'])
        && d.name is string        && d.name.size() > 0 && d.name.size() <= 80
        && d.image is string       && d.image.size() <= 900000   // cover image (data URL)
        && d.color is string       && d.color.size() <= 20
        && d.authorUid is string   && d.authorUid.size() <= 128
        && d.authorName is string  && d.authorName.size() <= 120
        && d.votes is number       && d.votes >= 0
        && d.approved is bool
        && d.questions is list     && d.questions.size() <= 60;
      // (Firestore also enforces a hard 1 MiB ceiling on the whole document,
      //  which bounds the inline questions + their images.)
    }

    // ---- A player's own save document (private) ----------------------------
    // Each signed-in user may read/write ONLY their own doc, in the exact shape
    // the app writes. The `data` map holds a few blobs (settings / saved games);
    // capping the key count stops it being turned into an arbitrary data store.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'data', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 12
        && request.resource.data.updatedAt is timestamp;
      // Account deletion: a user may erase their OWN saved data (the in-app
      // "حذف حسابي وبياناتي" flow deletes this doc, then the auth account).
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- Admin registry ----------------------------------------------------
    // Any signed-in user may READ this (so the app can tell if they're an admin
    // and show the admin tools). Only an existing admin may add/remove admins.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- Premium entitlements (who has an active subscription) --------------
    // A user may READ ONLY their own entitlement (so the app can unlock premium
    // for them). They can NEVER write it — so no one can grant themselves
    // premium from the client. It is set only by an admin (manual grant) or by
    // the backend writing via the Admin SDK (e.g. a RevenueCat webhook), which
    // bypasses these rules entirely. This is the real, tamper-proof paywall.
    match /entitlements/{uid} {
      // A user reads ONLY their own entitlement (to unlock premium / their game
      // allowance). An admin may also read/list all of them, so the admin panel
      // can show the current grantees. Neither can a user WRITE their own — only
      // an admin (manual grant) or the backend (Admin SDK) sets it. Tamper-proof.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---- One-time play codes ------------------------------------------------
    // An admin mints a code carrying a games allowance (or unlimited play) and
    // hands it to a player. The player redeems it ONCE; their play balance is
    // the sum of the codes they redeemed.
    //   • get: any signed-in user — but only by knowing the exact code (the doc
    //     id IS the code). They cannot LIST/browse codes to steal unused ones.
    //   • list: an admin sees everything; a player may only query the codes
    //     they themselves redeemed (usedBy == their uid) to compute their balance.
    //   • redeem (update): only flips used/usedBy/usedAt, only on a code that is
    //     still unused, and only to the caller's own uid. Firestore serializes
    //     writes, so two players racing for one code -> exactly one wins.
    //   • create/delete: admin only, shape-checked.
    match /codes/{codeId} {
      allow get: if isSignedIn();
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.usedBy == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['gamesAllowed', 'premium', 'used', 'usedBy', 'usedAt', 'createdAt'])
        && request.resource.data.gamesAllowed is int
        && request.resource.data.gamesAllowed >= 0
        && request.resource.data.gamesAllowed <= 1000
        && request.resource.data.premium is bool
        && request.resource.data.used == false
        && request.resource.data.usedBy == '';
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || ( isSignedIn()
          && resource.data.used == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt is timestamp );
    }

    // ---- Per-player game usage (soft consumed-count, admin-visible) ---------
    // A player writes ONLY their own usage doc — how many allowance games they
    // have consumed. An admin may read every player's doc to show each player's
    // REMAINING balance (granted − used) in the subscription panel. It holds no
    // personal data beyond the count. Client-updated, so not billing-grade — it
    // matches the free-plan soft-counter model used elsewhere.
    match /usage/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gamesUsed', 'updatedAt'])
        && request.resource.data.gamesUsed is int
        && request.resource.data.gamesUsed >= 0
        && request.resource.data.gamesUsed <= 100000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Official game content (admin CMS) ---------------------------------
    // Readable by everyone; writable only by admins, and shape-checked. The
    // parent doc holds metadata + a text-only copy of the questions; the full
    // questions (with images) live one-per-document so each gets its own 1 MiB.
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'image', 'color', 'order', 'questions', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 500;  // text-only copy; full Qs live in /questions
      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin()
          && request.resource.data.keys().hasOnly(['points', 'q', 'a', 'image', 'answerImage', 'idx'])
          && request.resource.data.points is number
          && request.resource.data.q is string
          && request.resource.data.q.size() <= 2000
          && request.resource.data.a is string
          && request.resource.data.a.size() <= 2000
          && request.resource.data.image is string
          && request.resource.data.answerImage is string
          && request.resource.data.idx is number;
        allow delete: if isAdmin();
      }
    }

    // ---- Community categories (member-submitted, admin-approved) -----------
    match /community/{catId} {

      // WHO CAN SEE IT:
      //   • approved categories  -> everyone
      //   • not-yet-approved ones -> only their author, or an admin
      // (So pending submissions stay private until you approve them.)
      allow read: if resource.data.approved == true
        || isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // SUBMIT a new category: any signed-in member, as themselves, and it
      // starts UNAPPROVED with zero votes. A member can't publish it live or
      // pre-set votes — only an admin can approve it (see update rule (a)).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.approved == false
        && request.resource.data.votes == 0
        && validCommunity(request.resource.data);

      // UPDATE — three separate, tightly-scoped cases:
      allow update: if isSignedIn() && (

        // (a) ADMIN moderation: approve, reject, or fix any submission.
        isAdmin()

        // (b) AUTHOR edits their OWN submission. They can't change the owner,
        //     can't touch the vote count, and can't self-approve — any edit
        //     forces it back to "pending" so you review the new content.
        || ( resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.approved == false
          && request.resource.data.votes == resource.data.votes
          && validCommunity(request.resource.data) )

        // (c) A VOTE by any signed-in member: ONLY the `votes` field may move,
        //     by exactly ±1, only on an approved category, never below 0, and
        //     ONLY in lock-step with creating/removing the caller's OWN
        //     /votes/{uid} doc in the SAME write (the client does both in one
        //     transaction). This makes it truly one-vote-per-member at the
        //     rules layer — a +1 requires the vote doc not to exist before and
        //     to exist after, so it can't be looped, and a -1 requires the
        //     reverse, so votes can't be stuffed or driven negative.
        || ( resource.data.approved == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes is int
          && request.resource.data.votes >= 0
          && (
               ( request.resource.data.votes == resource.data.votes + 1
                 && !exists(/databases/$(database)/documents/community/$(catId)/votes/$(request.auth.uid))
                 && existsAfter(/databases/$(database)/documents/community/$(catId)/votes/$(request.auth.uid)) )
            || ( request.resource.data.votes == resource.data.votes - 1
                 && exists(/databases/$(database)/documents/community/$(catId)/votes/$(request.auth.uid))
                 && !existsAfter(/databases/$(database)/documents/community/$(catId)/votes/$(request.auth.uid)) )
             ) )
      );

      // DELETE: the author may remove their own; an admin may remove anyone's.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);

      // One vote per member. The doc id IS the voter's uid, so a member can
      // only ever create/remove THEIR OWN vote — never vote twice or as anyone
      // else. Existing votes can't be edited.
      match /votes/{uid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ---- Everything else is denied -----------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
