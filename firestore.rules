rules_version = '2';

// Izzbah trivia security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the caller a registered admin? (admins/{uid} doc must exist)
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Per-user save document — each signed-in user reads/writes ONLY their own,
    // constrained to the exact shape the app writes. The `data` map holds a
    // small, fixed number of blobs (settings / saved games / preview choices);
    // cap the key count so it can't be turned into an arbitrary store. (Firestore
    // already enforces a hard 1 MiB per-document ceiling on total size.)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['email', 'data', 'updatedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 12
        && request.resource.data.updatedAt is timestamp;
    }

    // Admin registry. Anyone signed in may READ it (so the app can tell whether
    // the current user is an admin and show the admin UI). Only existing admins
    // may add/remove admins — bootstrap the FIRST admin manually in the console.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Published game content (admin CMS). Readable by everyone so all players
    // get the official categories; writable ONLY by admins, and shape-checked.
    // The parent doc holds metadata + a text-only copy of the questions; the
    // full questions (with images) live one-per-document in /questions so each
    // gets its own 1 MiB budget.
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'image', 'color', 'order', 'questions', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 200;
      allow delete: if isAdmin();

      // One document per question (text + its images). Public read; admin write,
      // now shape/type-checked so even a mistaken or compromised admin write
      // can't store malformed or unexpected data. (The image fields are data
      // URLs or links; their byte size is bounded by Firestore's 1 MiB doc limit.)
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin()
          && request.resource.data.keys().hasOnly(['points', 'q', 'a', 'image', 'answerImage', 'idx'])
          && request.resource.data.points is number
          && request.resource.data.q is string
          && request.resource.data.q.size() <= 2000
          && request.resource.data.a is string
          && request.resource.data.a.size() <= 2000
          && request.resource.data.image is string
          && request.resource.data.answerImage is string
          && request.resource.data.idx is number;
        allow delete: if isAdmin();
      }
    }

    // ---- Community categories (member-submitted) ----------------------------
    // Any signed-in member may publish a category here; everyone can read them.
    // Each doc holds its own questions inline (text + images) and a vote tally.
    // Members vote by creating a doc under /votes/{their uid}; the tally on the
    // parent may only move by ±1 per write. A member can edit/delete ONLY their
    // own category. (This opens writes to all signed-in users — content is not
    // moderated except by an admin deleting it; the ±1 vote rule is not proof
    // against a determined abuser, which would need Cloud Functions.)
    match /community/{catId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.votes == 0
        && request.resource.data.keys().hasOnly(['name', 'image', 'color', 'questions', 'authorUid', 'authorName', 'votes', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.questions is list
        && request.resource.data.questions.size() <= 12;

      allow update: if request.auth != null && (
        // (a) the author edits their own category — votes/author must not change
        ( resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.votes == resource.data.votes
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.questions is list
          && request.resource.data.questions.size() <= 12 )
        ||
        // (b) a vote — ONLY the votes field may change, and only by ±1
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && ( request.resource.data.votes == resource.data.votes + 1
            || request.resource.data.votes == resource.data.votes - 1 ) )
      );

      // Author may delete their own; an admin may remove anyone's (moderation).
      allow delete: if request.auth != null
        && (resource.data.authorUid == request.auth.uid || isAdmin());

      // One vote per member: the doc id IS the voter's uid, so nobody can vote
      // twice or vote as someone else.
      match /votes/{uid} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
